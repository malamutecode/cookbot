# LLM + web search
OPENAI_API_KEY=

# GCP
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIRESTORE_DATABASE=(default)
# Local dev only — points SDK at the emulator instead of real GCP
FIRESTORE_EMULATOR_HOST=localhost:8080

# Client identity
TENANT_ID=tastyhub
API_KEY=tk_live_...

# Optional — override defaults
LOG_LEVEL=INFO
MAX_HITL_ROUNDS=3
SESSION_TTL_HOURS=24
# Dev bypass: set to a non-empty string to allow x-dev-uid header auth (never set in production)
DEV_UID=dev_user

# Per-agent model selection
# Fast agents (chat orchestration, shopping list)
MODEL_CHAT=gpt-4o-mini
MODEL_SHOPPING_LIST=gpt-4o-mini
# Quality-critical agents (recipe generation and search)
MODEL_RECIPE_GEN=gpt-4o
MODEL_WEB_SEARCH=gpt-4o
MODEL_RECIPE_OPTIONS=gpt-4o

# Phase 2 only — not required for MVP
# DATABASE_URL=postgresql+asyncpg://cookbot:cookbot@localhost:5432/cookbot
# EMBEDDING_MODEL=text-embedding-3-small
