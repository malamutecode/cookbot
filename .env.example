# LLM + web search
OPENAI_API_KEY=

# GCP
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIRESTORE_DATABASE=(default)
# Local dev only — points SDK at the emulator instead of real GCP
FIRESTORE_EMULATOR_HOST=localhost:8080

# Client identity
TENANT_ID=tastyhub
API_KEY=tk_live_...

# Optional — override defaults
LOG_LEVEL=INFO
MAX_HITL_ROUNDS=3
SESSION_TTL_HOURS=24
# Dev bypass: set to a non-empty string to allow x-dev-uid header auth (never set in production)
DEV_UID=dev_user

# User management + per-user token quotas (STEP 42)
# Firebase uids seeded as admins on first sight (comma-separated) — bootstrap so
# there's a way into the Admin tab before any admin exists.
ADMIN_UIDS=
# Default per-user token budgets a new user inherits. 0 = unlimited. An admin
# can override per user from the Admin tab. Metering counts total tokens/turn.
DEFAULT_DAILY_TOKEN_LIMIT=1000000
DEFAULT_MONTHLY_TOKEN_LIMIT=10000000
# Timezone whose midnight / month-start defines the quota reset windows.
QUOTA_TIMEZONE=Europe/Warsaw

# Access whitelist — only these may authenticate (checked after Firebase token
# verification, on both REST and WebSocket). Comma-separated. Each entry is an
# exact email (a@x.com) or a whole domain (@example.com). EMPTY = open sign-in.
# This is the real access gate; CORS/allowed_origins only stops other browsers.
ALLOWED_EMAILS=

# CORS: browser origins allowed to call the API / open the WebSocket. Comma-
# separated. "*" for local dev; set to your Firebase Hosting domain(s) in prod.
ALLOWED_ORIGINS=*

# Per-agent model selection. gpt-4o-mini extracts recipe pages reliably one-shot;
# gpt-4o hit TPM limits on large pages. gpt-4o-mini is not deprecated — swap on merit.
# Fast agents (chat orchestration, shopping list)
MODEL_CHAT=gpt-4o-mini
MODEL_SHOPPING_LIST=gpt-4o-mini
# Recipe agents (generation, web search/extraction, options)
MODEL_RECIPE_GEN=gpt-4o-mini
MODEL_WEB_SEARCH=gpt-4o-mini
MODEL_RECIPE_OPTIONS=gpt-4o-mini

# Recipe proposal counts (STEP 47). A plain "przepis na X" with no extra
# requirements takes a zero-LLM fast path: DuckDuckGo + deterministic ranking,
# no model call (~3.5s vs ~11.7s, 0 tokens vs ~2600). Search results are free, so
# that path shows more cards; the LLM path stays smaller because each proposal it
# writes costs tokens against the user's quota.
PROPOSAL_COUNT=4          # cards from the reasoning (RecipeOptionsAgent) path
PROPOSAL_COUNT_FAST=6     # cards from the zero-LLM fast path
PROPOSAL_MIN_FAST=3       # below this many usable results, defer to the LLM path

# Phase 2 only — not required for MVP
# DATABASE_URL=postgresql+asyncpg://cookbot:cookbot@localhost:5432/cookbot
# EMBEDDING_MODEL=text-embedding-3-small
