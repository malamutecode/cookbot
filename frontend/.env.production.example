# Frontend production build config (Vite). Copy to `frontend/.env.production`
# and fill in. `.env.production` is gitignored — never commit real values.
# Vite only exposes vars prefixed with VITE_ to the client bundle.

# ── Auth mode ────────────────────────────────────────────────────────────────
# false = real Firebase auth (production). Leave unset in local dev to use the
# dev-uid bypass. It also auto-disables the bypass whenever Firebase config is set.
VITE_DEV_MODE=false

# ── API + WebSocket ──────────────────────────────────────────────────────────
# REST is same-origin: Firebase Hosting rewrites /v1 + /health to Cloud Run, so
# leave VITE_API_BASE empty.
VITE_API_BASE=

# The WebSocket connects DIRECTLY to Cloud Run (Hosting WS-over-rewrite is
# unreliable). Use the wss:// form of your Cloud Run service URL — get it with:
#   gcloud run services describe cookbot --region=europe-west1 \
#     --format='value(status.url)'
# e.g. https://cookbot-abc123-ew.a.run.app → wss://cookbot-abc123-ew.a.run.app
# ./infra/deploy-frontend.sh cross-checks this against the live service and
# refuses to ship a stale value (Vite bakes it into the bundle at build time).
VITE_WS_BASE=wss://<your-cloud-run-host>

# ── Firebase web app config ──────────────────────────────────────────────────
# From Firebase console → Project settings → General → Your apps → Web app → SDK
# setup and configuration → "Config". These are NOT secrets (they ship in the
# client bundle) — access control is the backend token verify + ALLOWED_EMAILS.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<your-project>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<your-project-id>
VITE_FIREBASE_APP_ID=

# ── Backend API key ──────────────────────────────────────────────────────────
# Only used for UNAUTHENTICATED calls (there shouldn't be any in prod, since all
# app calls carry a Firebase token). Match the value you stored in Secret Manager
# as `api-key` if you keep any anonymous endpoints. Usually leave blank in prod.
VITE_API_KEY=
