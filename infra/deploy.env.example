# Feedek deploy configuration — copy to `infra/deploy.env` and adjust.
#
#   cp infra/deploy.env.example infra/deploy.env
#
# `infra/deploy.env` is gitignored. Nothing here is a real secret (secrets live in
# Secret Manager), but it is per-environment, so it stays untracked.
#
# Every value can also be overridden by an env var of the same name already set in
# your shell — the scripts only fill in what isn't set.

# ── GCP / project identity ───────────────────────────────────────────────────
PROJECT_ID=feedek
REGION=europe-west1
AR_REPO=feedek

# Cloud Run service name. MUST match the `serviceId` in firebase.json's rewrites,
# or the Hosting /v1 proxy will point at a different (or nonexistent) service.
SERVICE=cookbot

# ── Backend app config (becomes Cloud Run env vars) ──────────────────────────
# Access whitelist: exact emails and/or whole domains (@example.com), comma-sep.
# EMPTY = open sign-in for anyone with a valid Firebase account. This is the real
# access gate — CORS only stops other browsers, not scripts.
ALLOWED_EMAILS=pawe213@gmail.com

# Browser origins allowed for CORS + the WebSocket origin check, comma-separated.
ALLOWED_ORIGINS=https://feedek.web.app,https://feedek.firebaseapp.com

# Firebase uids seeded as admins, comma-separated. Get one from:
#   uv run python clients/tastyhub/scripts/seed_admin.py
# (an email is NOT a uid). Leave empty and no one is bootstrapped as admin.
ADMIN_UIDS=

# Per-user token budgets a new user inherits. 0 = unlimited.
DEFAULT_DAILY_TOKEN_LIMIT=1000000
DEFAULT_MONTHLY_TOKEN_LIMIT=10000000

# ── Firebase Hosting ─────────────────────────────────────────────────────────
# Hosting site id; usually the same as PROJECT_ID. Used only for the printed URL.
FIREBASE_SITE=feedek
